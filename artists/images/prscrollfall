<script>
const canvas = document.getElementById("matrix");
const ctx = canvas.getContext("2d");

function resizeMatrix() {
    canvas.width = window.innerWidth;
    canvas.height = window.innerHeight;
}
resizeMatrix();

const letters = "PROJECTRADIO■";
const fontSize = 16;
let columns = Math.floor(canvas.width / fontSize);
let drops = Array(columns).fill(1);
let specialDrops = [];

function draw() {
    ctx.fillStyle = "rgba(0,0,0,0)";
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = "#0F0";
    ctx.font = fontSize + "px monospace";

    for (let i = 0; i < drops.length; i++) {
        const text = letters.charAt(Math.floor(Math.random() * letters.length));
        ctx.fillText(text, i * fontSize, drops[i] * fontSize);

        if (drops[i] * fontSize > canvas.height || Math.random() > 0.975) {
            drops[i] = 0;
        }
        drops[i]++;
    }

    if (Math.random() < 0.02) {
        specialDrops.push({
            x: Math.floor(Math.random() * columns),
            y: 0,
            word: "PROJECT RADIO".split("")
        });
    }

    specialDrops.forEach((drop, index) => {
        drop.word.forEach((char, i) => {
            ctx.fillStyle = "#B4FFB4";
            ctx.fillText(char, drop.x * fontSize, (drop.y + i) * fontSize);
        });

        drop.y++;

        if ((drop.y * fontSize) > canvas.height) {
            specialDrops.splice(index, 1);
        }
    });
}

setInterval(draw, 35);

window.addEventListener("resize", () => {
    resizeMatrix();
    columns = Math.floor(canvas.width / fontSize);
    drops = Array(columns).fill(1);
});
</script>