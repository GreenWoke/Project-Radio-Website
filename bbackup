  <!-- ✅ Enhanced JavaScript for BIOS-style Boot Sequence -->
  <script>
    window.addEventListener('load', () => {
      const splash = document.getElementById('splash-screen');
      const consoleOutput = document.getElementById('console-output');
      const sound = document.getElementById('boot-sound');
      
      // BIOS-style boot messages
      const bootMessages = [
        "PROJECT RADIO BIOS v2.7.5",
        "Copyright (C) 2025 PROJECT RADIO Foundation",
        "",
        "Performing system checks...",
        "CPU: ARMv9 Cortex-X5 @ 3.8GHz",
        "Memory Test: 32768MB OK",
        "Initializing Signal Processors... DONE",
        "Loading Cryptographic Modules... DONE",
        "Engaging Quantum Entanglement Array... DONE",
        "Detecting Peripheral Networks... FOUND",
        "Initializing PROJECT RADIO",
      ];
      
      let messageIndex = 0;
      let charIndex = 0;
      
      // Start sound
      sound.play().catch(e => console.warn('Autoplay blocked:', e));
      
      // Type effect function - much faster now
      function typeNextChar() {
        if (messageIndex < bootMessages.length) {
          // Still have messages to type
          const currentMessage = bootMessages[messageIndex];
          
          if (charIndex < currentMessage.length) {
            // Still typing current message
            consoleOutput.textContent += currentMessage.charAt(charIndex);
            charIndex++;
            
            // Much faster typing speed between 1ms and 3ms
            const randomDelay = Math.floor(Math.random() * 2) + 1;
            setTimeout(typeNextChar, randomDelay);
          } else {
            // End of current message, move to next line
            consoleOutput.textContent += "\n";
            messageIndex++;
            charIndex = 0;
            
            // Shorter pause between messages - just 20ms
            setTimeout(typeNextChar, 20);
          }
        } else {
          // All messages typed, fade out splash after a short delay
          setTimeout(() => {
            splash.classList.add('fade-out');
            splash.addEventListener('transitionend', () => splash.remove());
          }, 400);
        }
      }
      
      // Start typing immediately
      typeNextChar();
    });
  </script>
