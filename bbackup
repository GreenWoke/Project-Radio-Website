    @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400..900&display=swap');
    @import url('https://fonts.googleapis.com/css2?family=VT323&display=swap');

    /* Splash Screen Core */
    #splash-screen {
      position: fixed;
      inset: 0;
      background: black;
      color: #0f0;
      z-index: 9999;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      transition: opacity 0.5s ease;
      font-family: 'VT323', monospace;
    }

    #splash-screen.fade-out {
      opacity: 0;
      pointer-events: none;
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    /* BIOS Console */
    .console-container {
      width: 80%;
      max-width: 800px;
      height: 400px;
      background-color: black;
      border: 2px solid #0f0;
      border-radius: 5px;
      padding: 15px;
      overflow: hidden;
      position: relative;
      text-align: left;
    }

    .console-text {
      white-space: pre-line;
      font-size: 18px;
      line-height: 1.3;
      color: #0f0;
      text-shadow: 0 0 5px rgba(0, 255, 0, 0.7);
    }

    /* Cursor blink */
    .cursor {
      display: inline-block;
      width: 10px;
      height: 18px;
      background-color: #0f0;
      animation: blink 0.8s step-end infinite;
      margin-left: 2px;
      vertical-align: middle;
    }

    @keyframes blink {
      0%, 100% { opacity: 1; }
      50% { opacity: 0; }
    }
    
    .loading-label {
      color: #0f0;
      font-size: 24px;
      margin-bottom: 10px;
      font-weight: bold;
    }
  </style>
</head>

